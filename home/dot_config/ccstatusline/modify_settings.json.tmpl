#!/usr/bin/env bash
# ccstatusline bumps "version" itself when it migrates its own schema, so a
# plainly managed settings.json conflicts on every apply and drags the schema
# back to whatever this repo happens to carry. The rest of the file is ours:
# render the canonical copy, but keep the version already on disk.
set -euo pipefail

current=$(cat)

desired=$(cat <<'CHEZMOI_CANONICAL'
{{ includeTemplate "ccstatusline-settings.json" . }}
CHEZMOI_CANONICAL
)

# jq is in every role's manifest, but apply can run before `just install`.
version=$(command -v jq >/dev/null && printf '%s' "$current" | jq -r '.version' 2>/dev/null || true)

if [ -n "$version" ] && [ "$version" != "null" ]; then
    printf '%s\n' "$desired" | jq --argjson v "$version" '.version = $v'
else
    printf '%s\n' "$desired"
fi
