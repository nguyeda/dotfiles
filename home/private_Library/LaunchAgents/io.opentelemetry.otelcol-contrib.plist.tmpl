<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.opentelemetry.otelcol-contrib</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/otelcol-contrib</string>
    <string>--config</string>
    <string>{{ .chezmoi.homeDir }}/.config/otelcol-contrib/config.yaml</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Give the network a moment on login before the first flush attempt. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/otelcol-contrib/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/otelcol-contrib/stderr.log</string>
</dict>
</plist>
