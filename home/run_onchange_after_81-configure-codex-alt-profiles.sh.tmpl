#!/bin/bash
# Keep alternate Codex homes linked to ~/.codex so sessions, history, config,
# skills, and plugins are shared, while credentials, per-account caches, and
# per-instance runtime state (daemon sockets, pid files, tmp) stay isolated.
#
# Re-run when top-level ~/.codex entries change:
# {{ output "sh" "-c" "if [ -d \"$HOME/.codex\" ]; then (cd \"$HOME/.codex\" && for p in .* *; do case \"$p\" in .|..|.DS_Store|*.backup*|*.bak|*.bak-*|*-shm|*-wal) continue ;; esac; [ -e \"$p\" ] || [ -L \"$p\" ] || continue; printf '%s\\n' \"$p\"; done | sort); fi" | quote }}
set -euo pipefail

MASTER="$HOME/.codex"
PROFILES=("$HOME/.codex.legit")

if [ ! -d "$MASTER" ]; then
    echo "[codex-alt] $MASTER does not exist; skipping."
    exit 0
fi

should_skip() {
    local name="$1"

    case "$name" in
        # Per-instance runtime state. Sharing the daemon sockets would attach an
        # alternate profile to a daemon logged in as the master account.
        app-server-control|app-server-daemon|ipc|process_manager|shell_snapshots|tmp|.tmp)
            return 0
            ;;
        # Per-account state: model list, connector tools, desktop app state.
        cache|models_cache.json|.codex-global-state.json)
            return 0
            ;;
        # SQLite resolves the symlinked database and keeps its sidecars next to
        # the real file, so these must not be linked.
        *-shm|*-wal)
            return 0
            ;;
        # Backups: pure noise, and each new one re-triggers this script.
        *.backup*|*.bak|*.bak-*|.DS_Store)
            return 0
            ;;
    esac

    case "$name" in
        *[Aa][Uu][Tt][Hh]*|*[Tt][Oo][Kk][Ee][Nn]*|*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*)
            return 0
            ;;
    esac

    return 1
}

sync_profile() {
    local profile="$1"
    local source name dest target

    mkdir -p "$profile"

    for source in "$MASTER"/* "$MASTER"/.[!.]* "$MASTER"/..?*; do
        [ -e "$source" ] || [ -L "$source" ] || continue

        name="${source##*/}"
        should_skip "$name" && continue

        dest="$profile/$name"
        if [ -L "$dest" ]; then
            target="$(readlink "$dest" || true)"
            if [ "$target" != "$source" ]; then
                rm "$dest"
                ln -s "$source" "$dest"
                echo "[codex-alt] updated $dest -> $source"
            fi
        elif [ -e "$dest" ]; then
            echo "[codex-alt] keeping existing non-symlink $dest"
        else
            ln -s "$source" "$dest"
            echo "[codex-alt] linked $dest -> $source"
        fi
    done

    for dest in "$profile"/* "$profile"/.[!.]* "$profile"/..?*; do
        [ -L "$dest" ] || continue

        target="$(readlink "$dest" || true)"
        case "$target" in
            "$MASTER"/*)
                name="${dest##*/}"
                if should_skip "$name" || { [ ! -e "$MASTER/$name" ] && [ ! -L "$MASTER/$name" ]; }; then
                    rm "$dest"
                    echo "[codex-alt] removed stale/excluded symlink $dest"
                fi
                ;;
        esac
    done
}

for profile in "${PROFILES[@]}"; do
    sync_profile "$profile"
done

echo "[codex-alt] done."
