{{/* macOS window-manager / hotkey daemon — only on desktop-mac */}}
{{- if ne .role "desktop-mac" }}
.yabairc
.skhdrc
.config/aerospace
.config/yabai
{{- end }}

{{/* Server / minimal roles: no GUI terminal */}}
{{- if or (eq .role "devcontainer") (eq .role "pi") }}
.config/ghostty
{{- end }}

{{/* Devcontainer: skip tmux, vscode/cursor — host machine handles those */}}
{{- if eq .role "devcontainer" }}
.config/tmux
.tmux.conf
{{/* git author info is mounted from host (or set manually) — don't prompt */}}
run_once_after_50-configure-git.sh
{{- end }}

{{/* VSCode + Cursor user settings on desktop-fedora and desktop-mac */}}
{{- if and (ne .role "desktop-fedora") (ne .role "desktop-mac") }}
.config/Code
.config/Cursor
{{- end }}

{{/* Local OTel collector: only the desktop roles run one */}}
{{- if and (ne .role "desktop-fedora") (ne .role "desktop-mac") }}
.config/otelcol-contrib
Library/LaunchAgents/io.opentelemetry.otelcol-contrib.plist
.config/systemd/user/otelcol-contrib.service
run_onchange_after_85-otelcol-service.sh
{{- end }}

{{/* T3 Code background server: only the roles that install it */}}
{{- if and (ne .role "desktop-fedora") (ne .role "pi") }}
.config/systemd/user/t3code.service.d
run_onchange_after_87-t3code-service.sh
{{- end }}

{{/* launchd is macOS-only; systemd units are not */}}
{{- if ne .chezmoi.os "darwin" }}
Library/LaunchAgents
{{- else }}
.config/systemd
{{- end }}
